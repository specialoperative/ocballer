# ---- Control node ----------------------------------------------------------
ROLE=control                 # control | edge | capacity
PORT=8090
ANTHROPIC_API_KEY=sk-ant-... # drafting only; edge nodes do not need this
GRANT_SECRET=                # openssl rand -hex 32 — signs publish grants
DATABASE_PATH=./agents.db

# ---- Edge node (your second computer) --------------------------------------
# ROLE=edge
# NODE_ID=edge-2
# CONTROL_URL=http://<control-host>:8090
# DRIVER_URL=http://localhost:9222   # local session driver, never leaves this box
# POLL_SECONDS=30

# 1 = plan, draft, approve and claim work, but never actually publish.
DRY_RUN=1
