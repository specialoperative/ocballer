# ---- Drafting (required) --------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---- Approval SMS (required unless DRY_RUN=1) -----------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_MESSAGING_SERVICE_SID=MG...

# ---- Approval links --------------------------------------------------------
# Signs the one-tap approve/reject links. Rotating it invalidates pending links.
# openssl rand -hex 32
APPROVAL_SECRET=
# Public base URL of this service, used to build the links in the SMS.
PUBLIC_BASE_URL=http://localhost:8081

# ---- Publisher (the posting-only agent) -----------------------------------
# The separate process that holds the session and does nothing but publish an
# already-approved draft. It never receives anything but a single-use grant.
PUBLISHER_URL=
PUBLISHER_TOKEN=

# ---- Watcher handoff (optional) -------------------------------------------
# Comments on published posts are pushed here so they become alerts.
WATCHER_INGEST_URL=http://localhost:8080/ingest
WATCHER_INGEST_SECRET=

DATABASE_PATH=./poster.db
PORT=8081
# 1 = draft and log, never publish and never text. Start here.
DRY_RUN=1
