# ---- Classification (required) -------------------------------------------
# Console -> API keys: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- SMS (required) -------------------------------------------------------
# Twilio Console: https://console.twilio.com  (Account SID + Auth Token)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# A Messaging Service is strongly preferred over a bare from-number: it is what
# an A2P 10DLC campaign attaches to. Set ONE of these two.
TWILIO_MESSAGING_SERVICE_SID=MG...
# TWILIO_FROM_NUMBER=+15555550123

# ---- Collection (required only for the facebook source) -------------------
# URL of your own collector, which returns posts in the CollectorResponse shape
# documented in src/sources/facebook.ts. The Watcher does not log into any
# platform itself.
FB_COLLECTOR_URL=
FB_COLLECTOR_TOKEN=

# ---- Ingest endpoint (optional) ------------------------------------------
# Shared secret for POST /ingest. Generate with: openssl rand -hex 32
INGEST_SECRET=

# ---- Local -----------------------------------------------------------------
DATABASE_PATH=./watcher.db
PORT=8080
POLL_INTERVAL_SECONDS=90
# Set to 1 to log alerts instead of sending real SMS. Use this for the first run.
DRY_RUN=1
